<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMostrarQr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Encabezado -->
        <TextView
            android:id="@+id/txtTituloQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu código QR"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:gravity="start" />

        <TextView
            android:id="@+id/txtDetalleQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Actividad - Tipo de QR"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="start"
            android:lineSpacingExtra="4dp" />

        <!-- Tarjeta QR centrada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_payin_qr_card"
            android:elevation="3dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:letterSpacing="0.14"
                android:text="CÓDIGO QR"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.bylaba.containerqr.ZoomImageView
                android:id="@+id/imgQr"
                android:layout_width="@dimen/qr_image_size"
                android:layout_height="@dimen/qr_image_size"
                android:background="#FFFFFF"
                android:contentDescription="Imagen del código QR"
                android:padding="8dp"
                android:scaleType="matrix" />

            <TextView
                android:id="@+id/txtMensajeQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Buscando QR..."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Ayuda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_payin_qr_tip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:text="Escanea el código con la cámara de tu teléfono o con tu aplicación de pagos."
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Pie de página -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/brand_footer"
            android:textColor="#929D94"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>

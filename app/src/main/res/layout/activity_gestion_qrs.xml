<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGestionQrs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloGestionQrs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de QR"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actividad"
            android:textSize="15sp"
            android:textColor="#444444"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerActividades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de QR"
            android:textSize="15sp"
            android:textColor="#444444"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerTiposQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp" />

        <ImageView
            android:id="@+id/imgPreviewQr"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center_horizontal"
            android:background="#E0E0E0"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="Vista previa del código QR"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSeleccionarImagen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargar imagen QR"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnGuardarQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar / Actualizar QR"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtEstadoQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccione una actividad y tipo QR."
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMostrarQr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <!-- Encabezado -->
        <TextView
            android:id="@+id/txtTituloQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tu código QR"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:gravity="start" />

        <TextView
            android:id="@+id/txtDetalleQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:text="Actividad - Tipo de QR"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="start"
            android:lineSpacingExtra="3dp" />

        <!-- Tarjeta principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_payin_qr_card"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="22dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:letterSpacing="0.12"
                android:text="CÓDIGO QR"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- El QR conserva su proporción cuadrada -->
            <com.bylaba.containerqr.ZoomImageView
                android:id="@+id/imgQr"
                android:layout_width="@dimen/qr_image_size"
                android:layout_height="@dimen/qr_image_size"
                android:background="#FFFFFF"
                android:contentDescription="Imagen del código QR"
                android:padding="8dp"
                android:scaleType="matrix" />

            <TextView
                android:id="@+id/txtMensajeQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Buscando QR..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Recomendación para el usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_payin_qr_tip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:text="Escanea el código con la cámara de tu teléfono o con tu aplicación de pagos."
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Empuja el pie hacia abajo si hay espacio -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/brand_footer"
            android:textColor="#929D94"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTipoQr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_app"
    tools:context=".TipoQrActivity">

  <ScrollView
      android:id="@+id/scrollTiposQr"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:clipToPadding="false"
      android:fillViewport="true"
      android:paddingStart="22dp"
      android:paddingEnd="22dp"
      android:paddingTop="8dp"
      android:paddingBottom="16dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toTopOf="@id/txtMarcaAguaTipoQr"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/app_name"
          android:textColor="@color/primary"
          android:textSize="11sp"
          android:textStyle="bold"
          android:letterSpacing="0.08" />

      <TextView
          android:id="@+id/txtTituloTipo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="Tipos de QR"
          android:textColor="@color/text_primary"
          android:textSize="28sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="7dp"
          android:text="Selecciona el tipo de código que deseas consultar."
          android:textColor="@color/text_secondary"
          android:textSize="14sp"
          android:lineSpacingExtra="2dp" />

      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="20dp"
          app:cardBackgroundColor="@color/surface_card"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:strokeColor="@color/border"
          app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

          <ImageView
              android:layout_width="45dp"
              android:layout_height="45dp"
              android:background="@drawable/bg_nav_brand_icon"
              android:contentDescription="@string/app_name"
              android:padding="8dp"
              android:scaleType="fitCenter"
              android:src="@drawable/ic_hero_squares_2x2"
              app:tint="@color/primary" />

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actividad seleccionada"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtActividadSeleccionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Actividad"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="26dp"
          android:layout_marginBottom="12dp"
          android:text="Tipos disponibles"
          android:textColor="@color/text_primary"
          android:textSize="17sp"
          android:textStyle="bold" />

      <LinearLayout
          android:id="@+id/contenedorTiposQr"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical" />

    </LinearLayout>
  </ScrollView>

  <TextView
      android:id="@+id/txtMarcaAguaTipoQr"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/brand_footer"
      android:textColor="#929D94"
      android:textSize="11sp"
      android:gravity="center"
      android:paddingTop="10dp"
      android:paddingBottom="12dp"
      android:layout_marginStart="22dp"
      android:layout_marginEnd="22dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>